# Copy to the server: cp .env.production.example .env
# Generate secrets: openssl rand -hex 32

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=f17erp

# Public URL with HTTPS (required for Telegram Mini App)
APP_URL=https://erp.example.com
APP_PORT=3000

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_USE_POLLING=true
TELEGRAM_MINIAPP_URL=https://erp.example.com/miniapp

# Optional seed overrides (first deploy only)
SEED_OWNER_PHONE=+998901234567
SEED_SUPERADMIN_LOGIN=bobur
SEED_SUPERADMIN_PASSWORD=
